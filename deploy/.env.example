# Скопировать в deploy/.env и заполнить. deploy/.env в git НЕ коммитится.
# Пароли/ключи — только латиница и цифры (генерация: openssl rand -hex 24)

POSTGRES_DB=stroyai
POSTGRES_USER=stroyai
POSTGRES_PASSWORD=

# Ключ подписи сессий (минимум 32 символа): openssl rand -hex 32
SECRET_KEY=

# Cookie только по HTTPS. false — только для локальной проверки по http
COOKIE_SECURE=true
# Изменяющие запросы принимаются только с этого Origin
ALLOWED_ORIGINS=https://app.stroika.petr-ai.ru

# Учётная запись директора — создаётся при первом запуске, если директора ещё нет.
# При первом входе директор обязан сменить этот пароль (минимум 8 символов, буквы и цифры).
DIRECTOR_LOGIN=aslan
DIRECTOR_PASSWORD=
DIRECTOR_NAME=Карабасов Аслан

# Разделы, включённые в сборке фронтенда (этап 1 — только сотрудники)
VITE_ENABLED_SECTIONS=employees
# Сеть Caddy на сервере
CADDY_NETWORK=n8n_data_default
